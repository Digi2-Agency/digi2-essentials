{
  "id": "033-page-after-action",
  "desc": "return_visit -> akcja -> page: akcja zapisuje bieżącą odsłonę, więc page czeka do następnej (inaczej niż return_visit -> page, przypadek 028).",
  "since": "v1.9.0-ma.45",
  "envelope": {
    "version": "0",
    "site": "osiedle-demo",
    "minScript": "ma.44",
    "storage": {
      "retentionDays": 90,
      "consentRequired": false
    },
    "channels": {},
    "scenarios": [
      {
        "scenarioId": "rv-action-page",
        "revision": 1,
        "active": true,
        "nodes": [
          {
            "id": "t1",
            "type": "trigger",
            "when": {
              "event": "return_visit",
              "afterHours": 1
            }
          },
          {
            "id": "a1",
            "type": "action",
            "do": "datalayer",
            "event": "ma_segment",
            "params": {
              "segment": "rv"
            }
          },
          {
            "id": "t2",
            "type": "trigger",
            "when": {
              "event": "page",
              "paths": {
                "include": [
                  "/oferta"
                ]
              }
            }
          },
          {
            "id": "a2",
            "type": "action",
            "do": "datalayer",
            "event": "ma_segment",
            "params": {
              "segment": "rv-page"
            }
          }
        ],
        "edges": [
          [
            "t1",
            "a1"
          ],
          [
            "a1",
            "t2"
          ],
          [
            "t2",
            "a2"
          ]
        ]
      }
    ]
  },
  "visitor": {
    "visitorId": "aaaaaaaa-bbbb-4ccc-8ddd-000000000001",
    "consent": "granted",
    "device": "desktop",
    "lead": null,
    "profile": null
  },
  "visit": [
    {
      "t": 0,
      "path": "/oferta",
      "event": "page",
      "data": {}
    },
    {
      "t": 7200000,
      "path": "/oferta",
      "event": "page",
      "data": {}
    },
    {
      "t": 7210000,
      "path": "/oferta",
      "event": "page",
      "data": {}
    }
  ],
  "now": "2026-11-08T12:00:00+01:00",
  "expect": {
    "actions": [
      {
        "t": 7200000,
        "scenarioId": "rv-action-page",
        "nodeId": "a1",
        "do": "datalayer"
      },
      {
        "t": 7210000,
        "scenarioId": "rv-action-page",
        "nodeId": "a2",
        "do": "datalayer"
      }
    ]
  }
}
