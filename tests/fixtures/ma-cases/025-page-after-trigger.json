            "when": {
              "event": "unit_view",
              "unitIds": [],
              "minCount": 1
            }
          },
          {
            "id": "t2",
            "type": "trigger",
            "when": {
              "event": "page",
              "paths": {
                "include": [
                  "/oferta"
                ]
              }
            }
          },
          {
            "id": "a1",
            "type": "action",
            "do": "datalayer",
            "event": "ma_segment",
            "params": {
              "segment": "chain"
            }
          }
        ],
        "edges": [
          [
            "t1",
            "t2"
          ],
          [
            "t2",
            "a1"
          ]
        ]
      }
    ]
  },
  "visitor": {
    "visitorId": "aaaaaaaa-bbbb-4ccc-8ddd-000000000001",
    "consent": "granted",
    "device": "desktop",
    "lead": null,
    "profile": null
  },
  "visit": [
    {
      "t": 0,
      "path": "/oferta",
      "event": "page",
      "data": {}
    },
    {
      "t": 1000,
      "path": "/oferta",
      "event": "unit_view",
      "data": {
        "unit": {
          "unitId": "A1",
          "rooms": 2,
          "floor": 1
        }
      }
    },
    {
      "t": 5000,
      "path": "/oferta",
      "event": "page",
      "data": {}
    }
  ],
  "now": "2026-11-08T12:00:00+01:00",
  "expect": {
    "actions": [
      {
        "t": 5000,
        "scenarioId": "chain",
        "nodeId": "a1",
        "do": "datalayer"
      }
    ]
  }
}
