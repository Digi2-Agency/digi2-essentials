{
  "id": "025-page-after-trigger",
  "desc": "unit_view -> page: page to pierwsza pasująca odsłona otwarta PO obejrzeniu lokalu, nie ta, na której obejrzano.",
  "since": "v1.9.0-ma.44",
  "envelope": {
    "version": "0",
    "site": "osiedle-demo",
    "minScript": "ma.44",
    "storage": {
      "retentionDays": 90,
      "consentRequired": false
    },
    "channels": {},
    "scenarios": [
      {
        "scenarioId": "chain",
        "revision": 1,
        "active": true,
        "nodes": [
          {
            "id": "t1",
