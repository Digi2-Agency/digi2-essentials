        { "id": "a3", "type": "action", "do": "webhook", "channel": "sms", "template": "propozycja-terminu", "testOnly": true, "delayMinutes": 15 }
      ],
      "edges": [["t1", "a1"], ["a1", "t2"], ["t2", "t3"], ["t3", "a2"], ["a2", "a3"]]
