        { "id": "a2", "type": "action", "do": "popup", "template": "promo-rooms", "cta": "open_unit", "frequency": "once_per_days:3" }
      ],
      "edges": [["t1", "c1"], ["c1", "a1"], ["a1", "a2"]]
    },
    {
      "scenarioId": "lead-bez-kontaktu", "name": "Lead bez kontaktu", "revision": 1,
