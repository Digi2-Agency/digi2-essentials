    "sandbox": "node tests/browser/serve.js",
    "release:check": "bash scripts/release-check.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "terser": "^5.31.0"
  }
}
