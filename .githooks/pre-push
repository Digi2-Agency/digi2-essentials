#!/usr/bin/env bash
# Refuse to push a v* tag unless its commit passed the release gate FOR THAT
# VERSION.
#
# `scripts/release-check.sh vX.Y.Z` appends "<date> green vX.Y.Z" to
# <git-common-dir>/release-gate/<sha> on green with a clean tree;
# scripts/release.sh runs it before tagging. A green run without a version (or
# for another version) does not count: the version checks — CHANGELOG entry,
# branch, tag free — must have run for the name being pushed. A tag made by
# hand (`git tag`, `npm version`) on an unchecked commit stops here.
#
# Enabled per clone: git config core.hooksPath .githooks (npm install does it,
# scripts/release.sh too). `git push --no-verify` skips every hook — that is a
# deliberate bypass of the release procedure, not a way around this check.
set -euo pipefail

MARKS="$(git rev-parse --git-common-dir)/release-gate"
ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$ZERO" ] && continue            # deleting a tag
  tag=${remote_ref#refs/tags/}
  commit=$(git rev-parse "$local_sha^{commit}")      # annotated tag → its commit
  if ! grep -qsxF -e "$(printf '%s' "$tag")" <(awk '$2 == "green" { print $3 }' "$MARKS/$commit" 2>/dev/null); then
    echo "pre-push: $tag → ${commit:0:7} has not passed the release gate for $tag." >&2
    echo "          Release with: scripts/release.sh $tag \"…\"" >&2
    status=1
  fi
done

exit $status
